    <!-- News Rotation -->
    <script is:inline>
        async function initNewsRotation() {
            try {
                const response = await fetch('/api/blog/posts?limit=5');
                if (!response.ok) return;

                const posts = await response.json();
                if (!Array.isArray(posts) || posts.length === 0) {
                    document.getElementById('newsRotation').textContent = 'No posts yet';
                    return;
                }

                const latest = posts.slice(0, 5);
                let currentIndex = 0;

                function updateNews() {
                    const post = latest[currentIndex];
                    const newsText = document.getElementById('newsRotation');
                    newsText.style.opacity = '0';

                    setTimeout(() => {
                        const desc = (post.description || '').substring(0, 80);
                        newsText.innerHTML = `<strong>${post.title}</strong> - ${desc}${desc.length >= 80 ? '...' : ''}`;
                        newsText.style.opacity = '1';
                    }, 300);

                    currentIndex = (currentIndex + 1) % latest.length;
                }

                updateNews();
                if (latest.length > 1) {
                    setInterval(updateNews, 4000);
                }

            } catch (error) {
                console.log('News rotation not available');
            }
        }

        document.addEventListener('DOMContentLoaded', () => {
            initNewsRotation();
        });
    </script>
