            </div>

            <!-- Bottom Ad Banner -->
            <div class="post-viewer-ad post-viewer-ad-bottom">
                <div class="post-viewer-ad-placeholder">— AD —</div>
            </div>

            <!-- Footer Actions -->
            <div class="post-viewer-footer" id="viewerFooter">
                <button class="btn-viewer btn-viewer-close" onclick="closePostViewer()">닫기</button>
            </div>
        </div>
    </div>

    <!-- Footer -->
    <footer class="footer">
        <p>
            <span data-i18n="footerText">© 2026 Security Reports. 오픈소스 프로젝트</span>
            <br>
            <a href="https://github.com/bosong2/securityreports" target="_blank" rel="noopener noreferrer"
                data-i18n="footerGithub">GitHub에서 보기</a>
            |
            <a href="/privacy" data-i18n="footerPrivacy">개인정보 처리방침</a>
            |
            <a href="/about" data-i18n="footerAbout">소개</a>
            |
            <a href="/contact" data-i18n="footerContact">문의</a>
        </p>
    </footer>

    <!-- CDN Libraries (must load first) -->
    <script is:inline src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
    <script is:inline src="https://cdn.jsdelivr.net/npm/marked@12/marked.min.js"></script>

    <!-- Core Scripts -->
    <script is:inline src="/js/i18n.js" defer></script>
    <script is:inline src="/js/theme.js" defer></script>

    <!-- Auth Scripts (depend on Supabase CDN) -->
    <script is:inline src="/js/supabase-config.js"></script>
    <script is:inline src="/js/supabase-client.js"></script>
    <script is:inline src="/js/auth.js"></script>

    <!-- Blog Script -->
    <script is:inline src="/js/blog.js" defer></script>

    <script is:inline>
        // Auth gate for Create Post button + global auth state
        let currentSession = null;

        async function initBlogAuth() {
            try {
                // Wait for supabaseClient to be ready
                const client = window.supabaseClient;
                if (!client) {
                    // Fallback: create client directly
                    const sb = window.supabase.createClient(SUPABASE_CONFIG.url, SUPABASE_CONFIG.key);
                    const { data: { session } } = await sb.auth.getSession();
                    currentSession = session;
                    return session;
                }
                const { data: { session } } = await client.auth.getSession();
                currentSession = session;
                return session;
            } catch (e) {
                console.error('Auth init error:', e);
                return null;
            }
        }

        document.addEventListener('DOMContentLoaded', () => {
            initBlogAuth();

            const createBtn = document.getElementById('createPostBtn');
            if (createBtn) {
                createBtn.addEventListener('click', async () => {
                    if (currentSession) {
                        window.location.href = '/blog-submit';
                    } else {
                        const msg = window.i18n ? window.i18n.t('loginRequiredForSubmit') : '로그인 후 포스트를 작성할 수 있습니다.';
                        alert('🔒 ' + msg);
                    }
                });
            }
        });
    </script>

    <script is:inline>
        // =============================================
        // Post Viewer Modal
        // =============================================
        let currentViewingPost = null;

        async function openPostViewer(postId) {
            const post = window.blogSystem.posts.find(p => p.id === postId);
            if (!post) return;

            currentViewingPost = post;

            const overlay = document.getElementById('postViewerOverlay');
            const title = document.getElementById('viewerTitle');
            const meta = document.getElementById('viewerMeta');
            const body = document.getElementById('viewerBody');
            const footer = document.getElementById('viewerFooter');

            // Set header
            title.textContent = post.title;
            meta.textContent = `By ${post.author} · ${window.blogSystem.formatDate(post.date)}`;

            // Loading state
            body.innerHTML = `
                <div class="post-viewer-loading">
                    <div class="spinner"></div>
                    <span>콘텐츠 로드 중...</span>
                </div>
            `;

            // Build footer buttons
            let footerHTML = '';

            // Check ownership
            const isOwner = currentSession && post.user_id && currentSession.user.id === post.user_id;

            footerHTML += `<button class="btn-viewer btn-viewer-report" onclick="viewReportFromModal()">📊 리포트 보기</button>`;

            if (isOwner) {
                footerHTML += `<button class="btn-viewer btn-viewer-edit" onclick="editPost()">✏️ 수정</button>`;
                footerHTML += `<button class="btn-viewer btn-viewer-delete" onclick="deletePost()">🗑 삭제</button>`;
            }

            footerHTML += `<button class="btn-viewer btn-viewer-close" onclick="closePostViewer()">닫기</button>`;
            footer.innerHTML = footerHTML;

            // Show modal
            overlay.classList.add('active');
            document.body.style.overflow = 'hidden';

            // Fetch & render markdown
            try {
                const result = await window.blogSystem.loadPostContent(post);
                if (result && result.content) {
                    const html = marked.parse(result.content);
                    body.innerHTML = `<div class="post-viewer-content">${html}</div>`;
                } else {
                    body.innerHTML = `
                        <div class="post-viewer-loading">
                            <span>⚠️ 콘텐츠를 불러올 수 없습니다.</span>
                        </div>
                    `;
                }
            } catch (err) {
                console.error('Error loading post content:', err);
                body.innerHTML = `
                    <div class="post-viewer-loading">
                        <span>❌ 로드 실패: ${err.message}</span>
                    </div>
                `;
            }
        }

        function closePostViewer() {
            const overlay = document.getElementById('postViewerOverlay');
            overlay.classList.remove('active');
            document.body.style.overflow = '';
            currentViewingPost = null;
        }

        function viewReportFromModal() {
            if (currentViewingPost) {
                closePostViewer();
                window.blogSystem.viewReport(currentViewingPost.id);
            }
        }

        function editPost() {
            if (currentViewingPost) {
                // Navigate to submit page with edit mode (future feature)
                alert('✏️ 수정 기능은 준비 중입니다.');
            }
        }

        async function deletePost() {
            if (!currentViewingPost || !currentSession) return;

            const confirmed = confirm(`정말로 "${currentViewingPost.title}" 포스트를 삭제하시겠습니까?\n\n이 작업은 되돌릴 수 없습니다.`);
            if (!confirmed) return;

            try {
                const sb = window.supabase.createClient(SUPABASE_CONFIG.url, SUPABASE_CONFIG.key);
                const { data: { session } } = await sb.auth.getSession();
                if (!session) {
                    alert('세션이 만료되었습니다. 다시 로그인해주세요.');
                    return;
                }

                const response = await fetch(`/api/blog/posts?slug=${encodeURIComponent(currentViewingPost.id)}&token=${encodeURIComponent(session.access_token)}`, {
                    method: 'DELETE'
                });

                if (response.ok) {
                    alert('✅ 포스트가 삭제되었습니다.');
                    closePostViewer();
                    renderPosts(); // Re-render the list
                } else {
                    const result = await response.text();
                    let errMsg = '삭제에 실패했습니다.';
                    try { errMsg = JSON.parse(result).error || errMsg; } catch {}
                    alert('❌ ' + errMsg);
                }
            } catch (err) {
                console.error('Delete error:', err);
                alert('❌ 삭제 중 오류가 발생했습니다.');
            }
        }

        // Close on backdrop click
        document.addEventListener('click', (e) => {
            if (e.target.id === 'postViewerOverlay') closePostViewer();
        });

        // Close on ESC key
        document.addEventListener('keydown', (e) => {
            if (e.key === 'Escape') closePostViewer();
        });
    </script>

    <script is:inline>
        // =============================================
        // Render blog posts (with post viewer click)
        // =============================================
        function createPostCard(post) {
            return `
                <div class="post-card" onclick="openPostViewer('${post.id}')">
                    <h2 class="post-title">${post.title}</h2>
                    <p class="post-description">${post.description}</p>
                    <div class="post-tags">
                        ${post.tags.map(tag => `
                            <span class="tag ${tag === 'critical' ? 'critical' : ''}">${tag}</span>
                        `).join('')}
                    </div>
                    <div class="post-meta">
                        <span class="post-author">By ${post.author}</span>
                        <span>${window.blogSystem.formatDate(post.date)}</span>
                    </div>
                    <div class="post-actions">
                        <button class="btn-view-report" onclick="event.stopPropagation(); window.blogSystem.viewReport('${post.id}')">
                            <span data-i18n="viewReport">View Report</span> →
                        </button>
                    </div>
                </div>
            `;
        }

        async function renderPosts() {
            const container = document.getElementById('blogPosts');

            try {
                // Ensure blogSystem exists
                if (!window.blogSystem) {
                    if (window.BlogSystem) {
                        window.blogSystem = new BlogSystem();
                    } else {
                        throw new Error('BlogSystem not loaded');
                    }
                }

                await window.blogSystem.loadPosts();
                const posts = window.blogSystem.filteredPosts;

                if (posts.length === 0) {
                    container.innerHTML = `
                        <div class="empty-state">
                            <div class="empty-state-icon">📭</div>
                            <div data-i18n="noPosts">No posts found</div>
                        </div>
                    `;
                    return;
                }

                container.innerHTML = posts.map(post => createPostCard(post)).join('');

                // Update i18n
                if (window.i18n) window.i18n.updatePageLanguage();

            } catch (error) {
                console.error('Error rendering posts:', error);
                container.innerHTML = `
                    <div class="empty-state">
                        <div class="empty-state-icon">⚠️</div>
                        <div>Failed to load posts</div>
                    </div>
                `;
            }
        }

        // Render tag filters
        async function renderTagFilters() {
            const container = document.getElementById('tagFilters');
            if (!container) return;

            const tags = window.blogSystem.getAllTags();

            container.innerHTML = tags.map(tag => `
                <button class="filter-btn" data-tag="${tag}">${tag}</button>
            `).join('');

            // Add click handlers
            document.querySelectorAll('.filter-btn').forEach(btn => {
                btn.addEventListener('click', () => {
                    const tag = btn.dataset.tag;

                    // Update active state
                    document.querySelectorAll('.filter-btn').forEach(b => b.classList.remove('active'));
                    btn.classList.add('active');

                    // Filter posts
                    if (tag === 'all') {
                        window.blogSystem.filterByTags([]);
                    } else {
                        window.blogSystem.filterByTags([tag]);
                    }

                    renderPosts();
                });
            });
        }

        // Initialize
        async function init() {
            await renderPosts();
            await renderTagFilters();
        }

        document.addEventListener('DOMContentLoaded', () => {
            // Ensure blogSystem is initialized after deferred scripts run
            if (!window.blogSystem && window.BlogSystem) {
                console.log('Creating BlogSystem instance after DOMContentLoaded');
                window.blogSystem = new BlogSystem();
            }
            init();
        });

        // Search functionality
        document.getElementById('searchInput').addEventListener('input', (e) => {
            const query = e.target.value.toLowerCase().trim();

            if (!query) {
                renderPosts();
                return;
            }

            const filtered = window.blogSystem.filteredPosts.filter(post => {
                return post.title.toLowerCase().includes(query) ||
                    post.description.toLowerCase().includes(query) ||
                    post.author.toLowerCase().includes(query) ||
                    post.tags.some(tag => tag.toLowerCase().includes(query));
            });

            const container = document.getElementById('blogPosts');

            if (filtered.length === 0) {
                container.innerHTML = `
                    <div class="empty-state">
                        <div class="empty-state-icon">🔍</div>
                        <div>No posts found for "${query}"</div>
                    </div>
                `;
                return;
            }

            container.innerHTML = filtered.map(post => createPostCard(post)).join('');
        });
    </script>
</body>

</html>