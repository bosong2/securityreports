    </header>

    <!-- Navigation Tabs -->
    <nav class="nav-tabs">
        <div class="nav-container">
            <a href="/" class="nav-tab" data-i18n="navHome">홈</a>
            <a href="/blog" class="nav-tab active" data-i18n="tabBlog">블로그</a>
            <a href="/reports" class="nav-tab" data-i18n="navReports">리포트</a>
        </div>
    </nav>

    <!-- Blog Header -->
    <div class="blog-header">
        <h1 data-i18n="blogTitle">Community Security Reports</h1>
        <p data-i18n="blogSubtitle">Discover and share security vulnerabilities from the community</p>

        <!-- Search & Create -->
        <div class="blog-header-actions">
            <input type="text" id="searchInput" class="search-input" placeholder="Search posts..."
                data-i18n-placeholder="searchPlaceholder">
            <button class="btn-create" id="createPostBtn" data-i18n="createPost">
