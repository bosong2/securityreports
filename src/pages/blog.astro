    </div>

    <!-- Post Viewer Modal -->
    <div class="post-viewer-overlay" id="postViewerOverlay">
        <div class="post-viewer-frame">
            <!-- Header -->
            <div class="post-viewer-header">
                <div class="post-viewer-header-info">
